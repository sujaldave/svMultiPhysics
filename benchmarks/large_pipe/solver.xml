<?xml version="1.0" encoding="UTF-8" ?>
<!-- Lasso's 1M-tetrahedra pipe (make_pipe.py): R = 1 cm, L = 24 cm,
     181,875 nodes. Physics, BC types, time step, and solver tolerances
     follow tests/cases/fluid/iliac_artery/solver.xml: parabolic inflow,
     one resistance outlet with backflow stabilization, no-slip wall.
     run_benchmark.py overwrites the step count, output increments, and
     Linear_algebra block for every run. -->
<svMultiPhysicsFile version="0.1">
<GeneralSimulationParameters>

  <Continue_previous_simulation> 0 </Continue_previous_simulation>
  <Number_of_spatial_dimensions> 3 </Number_of_spatial_dimensions>
  <Number_of_time_steps> 10 </Number_of_time_steps>
  <Time_step_size> 0.001 </Time_step_size>
  <Spectral_radius_of_infinite_time_step> .5 </Spectral_radius_of_infinite_time_step>
  <Searched_file_name_to_trigger_stop> STOP_SIM </Searched_file_name_to_trigger_stop>

  <Save_results_to_VTK_format> 1 </Save_results_to_VTK_format>
  <Name_prefix_of_saved_VTK_files> result </Name_prefix_of_saved_VTK_files>
  <Increment_in_saving_VTK_files> 10 </Increment_in_saving_VTK_files>
  <Start_saving_after_time_step> 1 </Start_saving_after_time_step>

  <Increment_in_saving_restart_files> 10 </Increment_in_saving_restart_files>
  <Convert_BIN_to_VTK_format> 0 </Convert_BIN_to_VTK_format>

  <Verbose> 1 </Verbose>
  <Warning> 0 </Warning>
  <Debug> 0 </Debug>

</GeneralSimulationParameters>

<Add_mesh name="msh" >
    <Mesh_file_path> mesh/mesh-complete.mesh.vtu </Mesh_file_path>
    <Add_face name="inlet">
        <Face_file_path> mesh/mesh-surfaces/inlet.vtp </Face_file_path>
    </Add_face>
    <Add_face name="outlet">
        <Face_file_path> mesh/mesh-surfaces/outlet.vtp </Face_file_path>
    </Add_face>
    <Add_face name="wall">
        <Face_file_path> mesh/mesh-surfaces/wall.vtp </Face_file_path>
    </Add_face>
</Add_mesh>

<Add_equation type="fluid" >
   <Coupled> true </Coupled>
   <Min_iterations> 3 </Min_iterations>
   <Max_iterations> 12 </Max_iterations>
   <Tolerance> 1e-11 </Tolerance>
   <Backflow_stabilization_coefficient> 0.2 </Backflow_stabilization_coefficient>
   <Density> 1.06 </Density>

   <Viscosity model="Constant" >
     <Value> 0.04 </Value>
   </Viscosity>

   <Output type="Spatial" >
      <Velocity> true </Velocity>
      <Pressure> true </Pressure>
      <Traction> true </Traction>
      <Vorticity> true</Vorticity>
      <Divergence> true</Divergence>
      <WSS> true </WSS>
   </Output>

   <LS type="NS" >
      <Linear_algebra type="fsils" >
         <Preconditioner> fsils </Preconditioner>
      </Linear_algebra>
      <Max_iterations> 15 </Max_iterations>
      <NS_GM_max_iterations> 10 </NS_GM_max_iterations>
      <NS_CG_max_iterations> 300 </NS_CG_max_iterations>
      <Tolerance> 1e-3 </Tolerance>
      <NS_GM_tolerance> 1e-3 </NS_GM_tolerance>
      <NS_CG_tolerance> 1e-3 </NS_CG_tolerance>
      <Absolute_tolerance> 1e-17 </Absolute_tolerance>
      <Krylov_space_dimension> 250 </Krylov_space_dimension>
   </LS>

   <Add_BC name="inlet" >
      <Type> Dir </Type>
      <Time_dependence> Steady </Time_dependence>
      <Profile> Parabolic </Profile>
      <Impose_flux> true </Impose_flux>
      <Value> -100 </Value>
   </Add_BC>

   <Add_BC name="outlet" >
      <Type> Neu </Type>
      <Time_dependence> Resistance </Time_dependence>
      <Value> 16000 </Value>
   </Add_BC>

   <Add_BC name="wall" >
      <Type> Dir </Type>
      <Time_dependence> Steady </Time_dependence>
      <Value> 0.0 </Value>
   </Add_BC>

</Add_equation>

</svMultiPhysicsFile>
